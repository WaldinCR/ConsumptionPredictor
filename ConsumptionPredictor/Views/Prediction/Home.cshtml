}@{
ViewData["Title"] = "Inicio";
int modoActual = ViewBag.ModoActual ?? 1;
string nombreModo = modoActual switch
{
    1 => "Promedio Móvil Simple (SMA)",
    2 => "Regresión Lineal",
    3 => "Variación Porcentual",
    4 => "Detección de Tendencia",
    _ => "Promedio Móvil Simple (SMA)"
};
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">

        <div class="card">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <span>Predicción de Consumo Eléctrico</span>
                <span class="badge bg-secondary">@nombreModo</span>
            </div>
            <div class="card-body p-4">

                @if (TempData["Mensaje"] != null)
                {
                    <div class="alert @TempData["TipoMensaje"] alert-dismissible py-2" role="alert">
                        @TempData["Mensaje"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <p class="text-muted small mb-3">
                    Modo activo: <strong>@nombreModo</strong> &mdash;
                    <a href="/Prediccion/Modos">Cambiar modo</a>
                </p>

                <form method="post" action="/Prediccion/Calcular" id="formPrediccion">
                    <input type="hidden" name="Modo" value="@modoActual" />
                    <p class="text-muted small mb-2">Desde el mes más antiguo al más reciente</p>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th style="width:40px">#</th>
                                    <th>Fecha</th>
                                    <th>Consumo (kWh)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < 12; i++)
                                {
                                    <tr>
                                        <td class="text-center text-muted">@(@i + 1)</td>
                                        <td>
                                            <input type="date"
                                                   name="Consumos[@i].Fecha"
                                                   class="form-control form-control-sm"
                                                   required />
                                        </td>
                                        <td>
                                            <input type="number"
                                                   step="0.01"
                                                   min="0"
                                                   name="Consumos[@i].ValorKwh"
                                                   class="form-control form-control-sm"
                                                   placeholder="0.00"
                                                   required />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="d-grid mt-3">
                        <button type="submit" class="btn btn-primary">Calcular predicción</button>
                    </div>
                </form>

            </div>
        </div>

    </div>
</div>